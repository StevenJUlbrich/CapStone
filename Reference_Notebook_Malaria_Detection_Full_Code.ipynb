        "\n",
        "    plt.subplot(1, 2, 1)\n",
        "    plt.imshow(cv2.cvtColor(original_image, cv2.COLOR_BGR2RGB))\n",
        "    plt.title('Original Image')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.subplot(1, 2, 2)\n",
        "    plt.imshow(cv2.cvtColor(blurred_image, cv2.COLOR_BGR2RGB))\n",
        "    plt.title('Blurred Image')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.show()\n",
        "\n"
      ]
